# Скопируйте в .env и поменяйте значения перед любым показом клиенту.
# dev — локальная работа; prod — на сервере: сервис откажется стартовать с дефолтными секретами
KPBOT_ENV=dev
KPBOT_API_KEY=dev-api-key-change-me
# Общий пароль работает в dev; в проде вход только по логину пользователя
KPBOT_UI_PASSWORD=dev-password
# Разрешить вход общим паролем в проде (по умолчанию выключено)
KPBOT_ALLOW_SHARED_LOGIN=false
KPBOT_SESSION_SECRET=dev-session-secret-change-me
# Ключ шифрования паролей ящиков в базе. Пусто — берётся KPBOT_SESSION_SECRET.
KPBOT_SECRET_KEY=

# Реквизиты продавца в КП
KPBOT_COMPANY_NAME=ООО «Ромашка»
KPBOT_COMPANY_INN=7700000000
KPBOT_COMPANY_KPP=770001001
KPBOT_COMPANY_ADDRESS=г. Москва, ул. Примерная, д. 1, офис 10
KPBOT_COMPANY_PHONE=+7 (495) 000-00-00
KPBOT_COMPANY_EMAIL=sales@example.ru
KPBOT_COMPANY_SIGNER=Иванов И. И., коммерческий директор
# Банковские реквизиты для счёта и УПД в кабинете (можно заполнить в админке)
KPBOT_COMPANY_ACCOUNT=
KPBOT_COMPANY_BANK=
KPBOT_COMPANY_BIK=
KPBOT_COMPANY_CORR_ACCOUNT=

# Расчёт
# С 01.01.2026 основная ставка НДС в РФ — 22%. У клиента может быть 10%, 7%, 5% или 0.
KPBOT_VAT_RATE=0.22
KPBOT_DELIVERY_PRICE=0.00
KPBOT_QUOTE_VALID_DAYS=7

# Матчинг
KPBOT_MATCH_AUTO_THRESHOLD=0.75
KPBOT_MATCH_AMBIGUOUS_THRESHOLD=0.50

# Лимиты
KPBOT_MAX_UPLOAD_BYTES=2097152
KPBOT_MAX_RFQ_LINES=200
KPBOT_RATE_LIMIT_PER_MINUTE=60
# IP обратного прокси, которым верим в X-Forwarded-For (через запятую).
# На сервере с nginx: 127.0.0.1. Пусто — заголовок игнорируется.
KPBOT_TRUSTED_PROXIES=

# PDF (headless Chrome/Edge). В песочнице может быть недоступен — HTML и DOCX работают всегда.
KPBOT_PDF_ENABLED=true

# Почта: только пароль приложения, обычный пароль Google не принимает (2FA).
# Gmail: Аккаунт → Безопасность → Двухэтапная аутентификация → Пароли приложений.
KPBOT_IMAP_HOST=imap.gmail.com
KPBOT_IMAP_PORT=993
KPBOT_IMAP_USER=you@gmail.com
KPBOT_IMAP_PASSWORD=
KPBOT_IMAP_FOLDER=INBOX
KPBOT_IMAP_LIMIT=10
KPBOT_IMAP_MARK_SEEN=true

# OAuth2 (если «пароля приложения» в аккаунте нет — это единственный путь для Gmail).
# Google Cloud → APIs & Services → Credentials → OAuth client ID → Desktop app.
KPBOT_OAUTH_CLIENT_ID=
KPBOT_OAUTH_CLIENT_SECRET=
KPBOT_OAUTH_REDIRECT_PORT=8765

# LLM (извлечение позиций из писем). Ключ хранится ТОЛЬКО здесь и никогда не попадает в код,
# логи и артефакты: логи редактируются, в ответы API ключ не возвращается.
# Без ключа сервис работает на правилах — это штатный режим, а не ошибка.
KPBOT_LLM_ENABLED=false
KPBOT_LLM_BASE_URL=https://api.aitunnel.ru/v1
KPBOT_LLM_MODEL=deepseek-v4.1-flash-1017
KPBOT_LLM_API_KEY=
KPBOT_LLM_TIMEOUT_SECONDS=40
KPBOT_LLM_MAX_TOKENS=4000
# сколько символов письма уходит в модель (остальное разбирают правила)
KPBOT_LLM_MAX_INPUT_CHARS=24000
# тариф провайдера за 1 млн токенов, ₽. 0 = тариф не задан: считаем только токены
KPBOT_LLM_PRICE_INPUT_RUB_PER_1M=0
KPBOT_LLM_PRICE_OUTPUT_RUB_PER_1M=0

# Уведомления в Telegram: одна карточка — одно сообщение, дедупликация по заявке
KPBOT_TELEGRAM_ENABLED=false
KPBOT_TELEGRAM_BOT_TOKEN=
KPBOT_TELEGRAM_CHAT_ID=
KPBOT_TELEGRAM_API_BASE=https://api.telegram.org
# если провайдер режет отдельные адреса Telegram — укажите рабочий IP (DC) здесь
KPBOT_TELEGRAM_IP_OVERRIDE=
# по этой ссылке менеджер открывает карточку из уведомления
KPBOT_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Уведомления в MAX (мессенджер). Бот создаётся на платформе business.max.ru.
# API: platform-api2.max.ru, токен в заголовке Authorization, TLS через сертификат Минцифры
# (лежит в kpbot/certs, проверка сертификатов не отключается).
KPBOT_MAX_ENABLED=false
KPBOT_MAX_BOT_TOKEN=
KPBOT_MAX_USER_ID=
KPBOT_MAX_CHAT_ID=
KPBOT_MAX_API_BASE=https://platform-api2.max.ru

KPBOT_SMTP_ENABLED=false
# Письмо клиенту при смене статуса его заказа (нужен настроенный SMTP)
KPBOT_CABINET_NOTIFY_EMAIL=true

# 1С: OData — справочники и остатки; HTTP-сервис — запись счёта с позициями
# (шаблон сервиса: deploy/1c/kpbot-invoice.bsl, инструкция: docs/ONE_C_HTTP_SERVICE.md)
KPBOT_ONE_C_BASE_URL=
KPBOT_ONE_C_USER=
KPBOT_ONE_C_PASSWORD=
KPBOT_ONE_C_SERVICE_URL=
# Общий секрет HTTP-сервиса 1С: без него адрес сервиса = право создавать счета
KPBOT_ONE_C_SERVICE_TOKEN=
