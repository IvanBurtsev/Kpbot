// HTTP-сервис kpbot: создание счёта на оплату покупателю по JSON от kpbot.
//
// Основной путь записи — OData (шапка → PATCH строк → Post()), он проверен на
// живой Бухгалтерии 3.0. Этот сервис — резерв для баз, где права/состав OData
// запрещают прямую запись, или когда проведение/печать должен делать код 1С.
//
// Куда положить: Конфигуратор → Общие → HTTP-сервисы → добавить сервис «kpbot»,
// шаблон URL «/invoice», метод POST, обработчик — эта функция.
// Подробности и контракт: docs/ONE_C_HTTP_SERVICE.md
//
// Права: пользователь OData/HTTP должен иметь право «Использование» на сервис,
// чтение номенклатуры/контрагентов и добавление документов «Счёт на оплату».
//
// Безопасность: сервис требует заголовок X-Kpbot-Token, значение задаётся
// в функции ОжидаемыйТокен() и в KPBOT_ONE_C_SERVICE_TOKEN у kpbot.
// Ставка НДС берётся из строки запроса (поле vat, проценты), а не угадывается:
// с 01.01.2026 основная ставка — 22%, но бывают 20%, 10%, 7%, 5% и 0%.

Функция ОжидаемыйТокен() Экспорт
	// ЗАМЕНИТЕ на свой секрет и пропишите тот же в KPBOT_ONE_C_SERVICE_TOKEN.
	Возврат "ЗАМЕНИТЕ-НА-СВОЙ-СЕКРЕТ";
КонецФункции

Функция ТокенВерный(Запрос)
	Получен = Запрос.ПолучитьЗаголовок("X-Kpbot-Token");
	Возврат ЗначениеЗаполнено(Получен) И Получен = ОжидаемыйТокен();
КонецФункции

Функция СтавкаНДСПоПроценту(Процент)
	Если Процент = 22 Тогда
		Возврат Перечисления.СтавкиНДС.НДС22;
	ИначеЕсли Процент = 20 Тогда
		Возврат Перечисления.СтавкиНДС.НДС20;
	ИначеЕсли Процент = 10 Тогда
		Возврат Перечисления.СтавкиНДС.НДС10;
	ИначеЕсли Процент = 7 Тогда
		Возврат Перечисления.СтавкиНДС.НДС7;
	ИначеЕсли Процент = 5 Тогда
		Возврат Перечисления.СтавкиНДС.НДС5;
	КонецЕсли;
	Возврат Перечисления.СтавкиНДС.БезНДС;
КонецФункции

Функция СоздатьСчет(Запрос) Экспорт

	Результат = Новый Структура("ok, number, ref, error", Ложь, "", "", "");

	Если Не ТокенВерный(Запрос) Тогда
		Результат.error = "нет доступа: неверный токен сервиса";
		Возврат ОтветJSON(Результат, 401);
	КонецЕсли;

	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
		Результат.error = "Не разобран JSON: " + ОписаниеОшибки();
		Возврат ОтветJSON(Результат, 400);
	КонецПопытки;

	Попытка
		Счет = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
		Счет.Дата = ТекущаяДатаСеанса();
		Счет.Организация = ОрганизацияПоСсылке(Данные.organization);
		Счет.Контрагент = КонтрагентПоСсылке(Данные.counterparty);

		Если ЗначениеЗаполнено(Данные.warehouse) Тогда
			Счет.Склад = СкладПоСсылке(Данные.warehouse);
		КонецЕсли;

		Счет.ВалютаДокумента = ВалютаПоУмолчанию();

		Для Каждого СтрокаДанных Из Данные.lines Цикл
			Номенклатура = НоменклатураПоАртикулу(СтрокаДанных.sku);
			Если Номенклатура = Неопределено Тогда
				ВызватьИсключение("Нет номенклатуры с артикулом " + СтрокаДанных.sku);
			КонецЕсли;
			НоваяСтрока = Счет.Товары.Добавить();
			НоваяСтрока.Номенклатура = Номенклатура;
			НоваяСтрока.Количество = Число(СтрокаДанных.qty);
			НоваяСтрока.Цена = Число(СтрокаДанных.price);
			НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;

			ПроцентНДС = 0;
			Если СтрокаДанных.Свойство("vat") Тогда
				ПроцентНДС = Число(СтрокаДанных.vat);
			КонецЕсли;
			НоваяСтрока.СтавкаНДС = СтавкаНДСПоПроценту(ПроцентНДС);
			НоваяСтрока.СуммаНДС = Окр(НоваяСтрока.Сумма * ПроцентНДС / 100, 2);
		КонецЦикла;

		Счет.Комментарий = "Создано kpbot " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm");
		Счет.Записать(РежимЗаписиДокумента.Проведение);

		Результат.ok = Истина;
		Результат.number = Счет.Номер;
		Результат.ref = Строка(Счет.Ссылка.УникальныйИдентификатор());
	Исключение
		Результат.error = ОписаниеОшибки();
		Возврат ОтветJSON(Результат, 500);
	КонецПопытки;

	Возврат ОтветJSON(Результат);

КонецФункции

Функция ОтветJSON(Данные, Код = 200)

	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), "UTF-8");

	Возврат Ответ;

КонецФункции

Функция НоменклатураПоАртикулу(Артикул)

	Искомый = СокрЛП(Строка(Артикул));
	Если ПустаяСтрока(Искомый) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Искомый);

КонецФункции

Функция ОрганизацияПоСсылке(СсылкаИлиПусто)

	Если ЗначениеЗаполнено(СсылкаИлиПусто) Тогда
		Возврат Справочники.Организации.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Строка(СсылкаИлиПусто)));
	КонецЕсли;

	Выборка = Справочники.Организации.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	ВызватьИсключение("В базе нет организации — заполните её и повторите");

КонецФункции

Функция КонтрагентПоСсылке(СсылкаИлиПусто)

	Если ЗначениеЗаполнено(СсылкаИлиПусто) Тогда
		Возврат Справочники.Контрагенты.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Строка(СсылкаИлиПусто)));
	КонецЕсли;

	ВызватьИсключение("Не передан контрагент");

КонецФункции

Функция СкладПоСсылке(СсылкаИлиПусто)

	Если ЗначениеЗаполнено(СсылкаИлиПусто) Тогда
		Возврат Справочники.Склады.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Строка(СсылкаИлиПусто)));
	КонецЕсли;

	Выборка = Справочники.Склады.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ВалютаПоУмолчанию()

	Возврат Справочники.Валюты.НайтиПоКоду("643");

КонецФункции
