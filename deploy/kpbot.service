[Unit]
Description=kpbot — заявка из письма в коммерческое предложение
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kpbot
Group=kpbot
WorkingDirectory=/opt/kpbot
EnvironmentFile=/opt/kpbot/.env
ExecStart=/opt/kpbot/.venv/bin/uvicorn kpbot.web:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3
TimeoutStopSec=20

# минимум прав: сервису нужен только свой каталог
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kpbot/data

[Install]
WantedBy=multi-user.target